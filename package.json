{
  "name": "hawtend",
  "private": true,
  "version": "0.0.9",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && node scripts/build-notices.mjs && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "check:finance": "node --experimental-strip-types scripts/check-finance.ts",
    "check:cloud": "node --experimental-strip-types scripts/check-cloud.ts",
    "check:calendar": "node --experimental-strip-types scripts/check-calendar.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "katex": "0.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "overrides": {
    "katex": "$katex"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
